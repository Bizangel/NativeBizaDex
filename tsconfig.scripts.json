{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Force Node-friendly CJS for the scripts, regardless of RN setup
        "module": "CommonJS",
        "moduleResolution": "Node",
        "target": "ES2020",
        // Helpful for Node scripts
        "types": [
            "node"
        ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        // ts-node doesn't emit files, so this is fine
        "noEmit": true,
        "isolatedModules": false
    },
    // "include": [
    //     "data_extractor/**/*.ts",
    //     "src/**/*.ts",
    //     "src/**/*.tsx"
    // ],
}